# ---------------------------------------------------------------------------
# 로컬 축소 설정. 각 값 옆에 실제 운영값을 병기한다.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ottads

# Kafka
KAFKA_PARTITIONS=6              # 운영: 48
KAFKA_REPLICATION=1             # 운영: 3
KAFKA_RETENTION_MS=86400000     # 1일 / 운영: 7일

# Collector
COLLECTOR_PORT=8080
COLLECTOR_HMAC_SECRET=local-dev-secret
COLLECTOR_KAFKA_MAX_BLOCK_MS=2000
COLLECTOR_PUBLISH_TIMEOUT_MS=3000

# Flink
FLINK_TASK_SLOTS=2              # 운영: 20
FLINK_WATERMARK_DELAY=10        # seconds

# ad-decision / Outbox
AD_NO_FILL_RATE=0.08            # 노필 비율
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=500           # 운영: 1000~5000
OUTBOX_UPDATE_FAIL_RATE=0.02    # 발행 후 플래그 업데이트 실패 재현 확률 (중복 발생원)

# Postgres
POSTGRES_DB=adplatform
POSTGRES_USER=ads
POSTGRES_PASSWORD=ads

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=events
