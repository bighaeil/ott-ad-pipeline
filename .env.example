# ---------------------------------------------------------------------------
# 로컬 축소 설정 견본. 각 값 옆에 실제 운영값을 병기한다.
#
# 사용법: 이 파일을 .env 로 복사해서 쓴다 (make up / make.ps1 up 이 없으면 자동 복사).
#   cp .env.example .env
# .env 는 .gitignore 대상이다. 실제 비밀값은 .env 에만 넣고 이 파일에는 넣지 않는다.
# 모든 값은 docker-compose.yml 에 같은 기본값이 있어서, .env 가 비어 있어도 뜬다.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ottads

# Kafka
KAFKA_PARTITIONS=6              # 운영: 48
KAFKA_REPLICATION=1             # 운영: 3
KAFKA_RETENTION_MS=86400000     # 1일 / 운영: 7일

# Collector
COLLECTOR_PORT=8080
COLLECTOR_HMAC_SECRET=local-dev-secret   # 로컬 전용. 바꾸면 generator/tracer/player 도 같은 값을 받는다
COLLECTOR_KAFKA_MAX_BLOCK_MS=2000
COLLECTOR_PUBLISH_TIMEOUT_MS=3000

# Flink
FLINK_TASK_SLOTS=2              # 운영: 20
# FLINK_WATERMARK_DELAY 는 여기 적어도 반영되지 않는다 (Compose 가 아니라 flink-submit.sh 가 읽음).
#   바꾸려면: FLINK_WATERMARK_DELAY=2 bash scripts/flink-submit.sh  또는  make flink WM=2

# ad-decision / Outbox
AD_NO_FILL_RATE=0.08            # 노필 비율
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=500           # 운영: 1000~5000
OUTBOX_UPDATE_FAIL_RATE=0.02    # 발행 후 플래그 업데이트 실패 재현 확률 (중복 발생원)

# Postgres
POSTGRES_DB=adplatform
POSTGRES_USER=ads
POSTGRES_PASSWORD=ads

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=events
